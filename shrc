#!/bin/sh

export IGNOREEOF=10
export CLICOLOR=1
export LSCOLORS=gxBxhxDxfxhxhxhxhxcxcx
export EDITOR=nvim
export PAGER=less
export HISTCONTROL=ignoredups

case $- in
    *i*)
        for file in ~/.sh/* ; do
            if [ -f "$file" ]; then
                source "$file"
            fi
        done
        ;;
esac

# Prepend a directory to PATH unless it is already there. The directory need not
# exist yet, so entries start working as soon as something creates them.
prepend_path() {
    [ -n "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) return 0 ;;
    esac
    PATH="$1:$PATH"
}

export COMPOSER_MEMORY_LIMIT=-1

export PNPM_HOME="$HOME/.local/share/pnpm"

prepend_path ~/.composer/vendor/bin
prepend_path ~/.local/bin
prepend_path ~/.local/share/nvim/mason/bin
prepend_path "$PNPM_HOME"
prepend_path ~/.opencode/bin
# zim's asdf module only adds this in interactive zsh; GUI apps need it too.
prepend_path "${ASDF_DATA_DIR:-$HOME/.asdf}/shims"

# Gem.user_dir is scoped to the Ruby ABI version, so take the newest version dir
# present rather than paying ~180ms to ask Ruby which one is active. Older dirs
# stay off PATH: their binstubs pin an interpreter that may no longer exist.
# `find` avoids a glob, which zsh's default NOMATCH would make fatal here.
_gem_bin=$(find "${XDG_DATA_HOME:-$HOME/.local/share}/gem/ruby" \
    -mindepth 2 -maxdepth 2 -type d -name bin 2>/dev/null | sort -V | tail -n 1)
prepend_path "$_gem_bin"
unset _gem_bin

# Send `go install` to a version-independent dir already on PATH, so Go tools
# survive asdf version switches without consulting GOPATH. `go install` refuses a
# cross-compile while GOBIN is set, so clear it for that one command:
# `GOBIN= GOOS=darwin go install .`.
export GOBIN="$HOME/.local/bin"
